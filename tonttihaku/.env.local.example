# Maanmittauslaitos API Key
MML_API_KEY=your_mml_api_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Site password (shared password for access)
SITE_PASSWORD=your_site_password_here

# CARTO basemaps (map "Vaalea" layer) — free key from https://carto.com/basemaps/apikey
# NEXT_PUBLIC_* is inlined at build time: this file only covers local dev, so the key
# must ALSO be set in Vercel → Settings → Environment Variables (Production) and the
# site redeployed afterwards.
NEXT_PUBLIC_CARTO_API_KEY=your_carto_basemaps_key_here
